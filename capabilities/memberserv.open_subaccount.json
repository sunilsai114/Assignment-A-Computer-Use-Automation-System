{
  "meta": {
    "id": "memberserv.open_subaccount",
    "name": "Open a sub-account for a member",
    "description": "Finds the member, fills the new sub-account form, checks the review screen, then submits. Submitting is irreversible and needs a human's approval on every run.",
    "schema_version": "1",
    "version": "1.0.0",
    "status": "approved",
    "app": "memberserv",
    "variant": "heritage",
    "created_by": "hand-authored"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "description": "Member number to look up.",
      "required": true,
      "pattern": "[0-9A-Za-z-]{1,20}",
      "sensitive": false
    },
    {
      "name": "product",
      "type": "enum",
      "description": "Type of sub-account to open.",
      "required": true,
      "enum": [
        "Savings",
        "Checking",
        "Money Market"
      ],
      "sensitive": false
    },
    {
      "name": "opening_deposit",
      "type": "money",
      "description": "Opening deposit in USD (minimum $25).",
      "required": true,
      "sensitive": false
    },
    {
      "name": "nickname",
      "type": "string",
      "description": "Optional label shown to the member.",
      "required": false,
      "default": "",
      "pattern": "[\\w .'-]{0,30}",
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "review_deposit",
      "type": "money",
      "description": "Deposit amount as confirmed on the review screen.",
      "sensitive": false
    },
    {
      "name": "reference",
      "type": "string",
      "description": "Application reference from the confirmation.",
      "sensitive": false
    }
  ],
  "preconditions": [],
  "steps": [
    {
      "id": "open_app",
      "intent": "Open the MemberServ home frameset",
      "action": "navigate",
      "value": {
        "literal": "/heritage/"
      },
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": []
    },
    {
      "id": "open_inquiry",
      "intent": "Open Member Inquiry from the left nav",
      "action": "click",
      "target": {
        "frame_path": [
          "n"
        ],
        "locators": [
          {
            "kind": "text",
            "params": {
              "text": "Member Inquiry"
            },
            "robustness": "medium",
            "why": "Visible link text."
          }
        ]
      },
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": [
        {
          "kind": "text_present",
          "text": "Member Inquiry",
          "frame": "m"
        }
      ]
    },
    {
      "id": "enter_member",
      "intent": "Type the member number",
      "action": "type",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "label_text",
            "params": {
              "text": "Member Number"
            },
            "robustness": "medium",
            "why": "Label sits in the neighbouring <td>; survives markup reshuffles."
          },
          {
            "kind": "attr",
            "params": {
              "attr": "name",
              "value": "f1"
            },
            "robustness": "medium",
            "why": "Cryptic but stable field name in a slowly-changing app."
          }
        ],
        "expect_tag": "input"
      },
      "value": {
        "param": "member_id"
      },
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": []
    },
    {
      "id": "submit_search",
      "intent": "Submit the search",
      "action": "click",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "role",
            "params": {
              "role": "button",
              "name": "Go"
            },
            "robustness": "high",
            "why": "Submit button by accessible name."
          },
          {
            "kind": "attr",
            "params": {
              "attr": "value",
              "value": "Go"
            },
            "robustness": "medium",
            "why": "Fallback on button value."
          }
        ]
      },
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": [
        {
          "kind": "text_present",
          "text": "Member {{member_id}}",
          "frame": "m"
        }
      ]
    },
    {
      "id": "open_new_subaccount",
      "intent": "Open the New Sub-Account form",
      "action": "click",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "text",
            "params": {
              "text": "New Sub-Account"
            },
            "robustness": "medium",
            "why": "A clickable <span>, not a link: visible text is the only handle."
          }
        ]
      },
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": [
        {
          "kind": "text_present",
          "text": "Open Sub-Account",
          "frame": "m"
        }
      ]
    },
    {
      "id": "choose_product",
      "intent": "Choose the product type",
      "action": "select",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "label_text",
            "params": {
              "text": "Product Type"
            },
            "robustness": "medium",
            "why": "Adjacent label."
          },
          {
            "kind": "attr",
            "params": {
              "attr": "name",
              "value": "p1"
            },
            "robustness": "medium",
            "why": "Stable field name."
          }
        ],
        "expect_tag": "select"
      },
      "value": {
        "param": "product"
      },
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": []
    },
    {
      "id": "enter_deposit",
      "intent": "Enter the opening deposit",
      "action": "type",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "label_text",
            "params": {
              "text": "Opening Deposit"
            },
            "robustness": "medium",
            "why": "Adjacent label."
          },
          {
            "kind": "attr",
            "params": {
              "attr": "name",
              "value": "p2"
            },
            "robustness": "medium",
            "why": "Stable field name."
          }
        ],
        "expect_tag": "input"
      },
      "value": {
        "param": "opening_deposit"
      },
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": []
    },
    {
      "id": "enter_nickname",
      "intent": "Enter the nickname",
      "action": "type",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "label_text",
            "params": {
              "text": "Nickname"
            },
            "robustness": "medium",
            "why": "Adjacent label."
          },
          {
            "kind": "attr",
            "params": {
              "attr": "name",
              "value": "p3"
            },
            "robustness": "medium",
            "why": "Stable field name."
          }
        ],
        "expect_tag": "input"
      },
      "value": {
        "param": "nickname"
      },
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": []
    },
    {
      "id": "continue_to_review",
      "intent": "Continue to the review screen",
      "action": "click",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "role",
            "params": {
              "role": "button",
              "name": "Continue"
            },
            "robustness": "high",
            "why": "Button by name."
          }
        ]
      },
      "parse": "text",
      "risk": "risky",
      "pre": [],
      "post": [
        {
          "kind": "text_present",
          "text": "Review Sub-Account Application",
          "frame": "m"
        }
      ]
    },
    {
      "id": "read_review_deposit",
      "intent": "Read the deposit shown for review",
      "action": "read",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "table_cell",
            "params": {
              "row_text": "Deposit",
              "col": 1
            },
            "robustness": "medium",
            "why": "Row found by its label."
          }
        ]
      },
      "output": "review_deposit",
      "parse": "money",
      "risk": "safe",
      "pre": [],
      "post": []
    },
    {
      "id": "submit_application",
      "intent": "Submit the application",
      "action": "click",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "role",
            "params": {
              "role": "button",
              "name": "Submit Application"
            },
            "robustness": "high",
            "why": "Button by name."
          }
        ]
      },
      "parse": "text",
      "risk": "irreversible",
      "pre": [],
      "post": [
        {
          "kind": "text_present",
          "text": "Application submitted",
          "frame": "m"
        }
      ]
    },
    {
      "id": "read_reference",
      "intent": "Read the application reference",
      "action": "read",
      "target": {
        "frame_path": [
          "m"
        ],
        "locators": [
          {
            "kind": "table_cell",
            "params": {
              "row_text": "Reference",
              "col": 1
            },
            "robustness": "medium",
            "why": "Row found by its label."
          }
        ]
      },
      "output": "reference",
      "parse": "text",
      "risk": "safe",
      "pre": [],
      "post": []
    }
  ],
  "success": {
    "kind": "text_present",
    "text": "Application submitted",
    "frame": "m"
  },
  "outcomes": [
    {
      "code": "member_not_found",
      "description": "No member matches that number.",
      "detected_by": {
        "kind": "text_present",
        "text": "No records match your request",
        "frame": "m"
      },
      "returns": {
        "found": false
      }
    },
    {
      "code": "permission_denied",
      "description": "Operator may not view this record.",
      "detected_by": {
        "kind": "text_present",
        "text": "Access denied",
        "frame": "m"
      },
      "returns": {}
    },
    {
      "code": "invalid_member_number",
      "description": "The app rejected the number's format.",
      "detected_by": {
        "kind": "text_present",
        "text": "must be numeric",
        "frame": "m"
      },
      "returns": {}
    },
    {
      "code": "deposit_below_minimum",
      "description": "The opening deposit is under the $25 minimum.",
      "detected_by": {
        "kind": "text_present",
        "text": "Minimum opening deposit",
        "frame": "m"
      },
      "returns": {}
    },
    {
      "code": "deposit_not_a_number",
      "description": "The app could not read the deposit amount.",
      "detected_by": {
        "kind": "text_present",
        "text": "must be a number",
        "frame": "m"
      },
      "returns": {}
    }
  ],
  "interstitials": [
    {
      "name": "rate_notice",
      "detected_by": {
        "kind": "text_present",
        "text": "Rate sheet updated",
        "frame": "m"
      },
      "dismiss": {
        "id": "dismiss.rate_notice",
        "intent": "Acknowledge the rate notice",
        "action": "click",
        "target": {
          "frame_path": [
            "m"
          ],
          "locators": [
            {
              "kind": "text",
              "params": {
                "text": "Continue"
              },
              "robustness": "medium",
              "why": "Visible link text."
            }
          ]
        },
        "parse": "text",
        "risk": "safe",
        "pre": [],
        "post": []
      },
      "resume_from": "enter_member"
    }
  ],
  "auth": {
    "steps": [
      {
        "id": "auth.user",
        "intent": "Enter operator id",
        "action": "type",
        "target": {
          "frame_path": [
            "m"
          ],
          "locators": [
            {
              "kind": "label_text",
              "params": {
                "text": "Operator ID"
              },
              "robustness": "medium",
              "why": "Adjacent label."
            }
          ],
          "expect_tag": "input"
        },
        "value": {
          "secret_env": "HERITAGE_USER"
        },
        "parse": "text",
        "risk": "safe",
        "pre": [],
        "post": []
      },
      {
        "id": "auth.pass",
        "intent": "Enter passcode",
        "action": "type",
        "target": {
          "frame_path": [
            "m"
          ],
          "locators": [
            {
              "kind": "label_text",
              "params": {
                "text": "Passcode"
              },
              "robustness": "medium",
              "why": "Adjacent label."
            }
          ],
          "expect_tag": "input"
        },
        "value": {
          "secret_env": "HERITAGE_PASS"
        },
        "parse": "text",
        "risk": "safe",
        "pre": [],
        "post": []
      },
      {
        "id": "auth.submit",
        "intent": "Sign on",
        "action": "click",
        "target": {
          "frame_path": [
            "m"
          ],
          "locators": [
            {
              "kind": "role",
              "params": {
                "role": "button",
                "name": "Sign On"
              },
              "robustness": "high",
              "why": "Button by name."
            }
          ]
        },
        "parse": "text",
        "risk": "safe",
        "pre": [],
        "post": []
      }
    ],
    "logged_in_when": {
      "kind": "text_present",
      "text": "Member Inquiry",
      "frame": "m"
    },
    "session_expired_when": {
      "kind": "text_present",
      "text": "Operator ID",
      "frame": "m"
    }
  },
  "variants": []
}